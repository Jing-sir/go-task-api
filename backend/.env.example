# 后端环境变量模板。
# 用法：复制成 .env 再按本机情况改，.env 不会进版本库。
#   cp backend/.env.example backend/.env

# 数据库。端口 5433 是 docker-compose 里 db 服务对外映射的端口，
# 这么设是为了不和本机自带的 PostgreSQL（5432）抢端口。
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=go_task_db
DB_SSLMODE=disable

# JWT 签名密钥。本地随便填，但不能留空（留空会被启动时的校验拦住）。
# 以后真要部署到服务器时，换成足够长的随机值：openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=3

SERVER_PORT=8080
REDIS_ADDR=localhost:6379
